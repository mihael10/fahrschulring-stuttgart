# Public site URL, used for canonical metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.fahrschulring.de

# SMTP credentials for the contact form (src/app/api/contact/route.ts).
# Without these set, the form fails gracefully with a "call us" message
# and logs the submission to the server console instead of losing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact form leads get delivered. Defaults to the address in
# src/content/site.ts if unset.
CONTACT_TO_EMAIL=info@fahrschulring.de

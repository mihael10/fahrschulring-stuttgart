# Where THIS build is served (only used for the absolute og:image URL).
# Canonical URLs, sitemap and JSON-LD always use the production host
# (src/lib/site-url.ts) regardless of this value. deploy.yml sets it to the
# Pages URL for previews, or to https://<PRODUCTION_DOMAIN> for production.
NEXT_PUBLIC_SITE_URL=https://mihael10.github.io/fahrschulring-stuttgart

# Set to "true" ONLY for the production build on www.fahrschulring.de:
# makes pages indexable, adds canonicals, drops the basePath. Previews
# must leave it unset (they are noindex). See knowledge/seo-strategy.md.
SITE_IS_PRODUCTION=

# Contact form endpoint — URL of alfahosting/kontakt.php on the Alfahosting
# webspace (e.g. https://www.fahrschulring.de/kontakt.php). In production it
# comes from the CONTACT_ENDPOINT repository variable (deploy.yml). Empty =
# the form opens the visitor's mail app with the message pre-filled instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Google Places API — powers live Google reviews on the homepage
# (src/components/GoogleReviews.tsx). Without these, the section falls back
# to a dated static snapshot (rating/count only, no fabricated review text).
# See knowledge/content-editing.md for how to get a real place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJR0zjFTzbmUcRAbC_uztld74

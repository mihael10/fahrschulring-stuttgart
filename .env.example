# Public site URL, used for canonical metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.fahrschulring.de

# SMTP credentials for the contact form (src/app/api/contact/route.ts).
# Without these set, the form fails gracefully with a "call us" message
# and logs the submission to the server console instead of losing it.
#
# The client's mailbox is GMX. GMX's outgoing mail server is mail.gmx.net,
# port 587 (STARTTLS). SMTP_USER/SMTP_PASS are the full GMX address and its
# password (an app-specific password if 2FA is on) — see
# knowledge/content-editing.md for the exact GMX account setting that must
# be enabled first (POP3/IMAP access), or sending will fail with an auth error.
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where contact form leads get delivered — the client's real GMX inbox.
# Defaults to the address in src/content/site.ts if unset, which is the
# fahrschulring.de address, NOT the GMX mailbox — set this explicitly.
CONTACT_TO_EMAIL=

# Google Places API — powers live Google reviews on the homepage
# (src/components/GoogleReviews.tsx). Without these, the section falls back
# to a dated static snapshot (rating/count only, no fabricated review text).
# See knowledge/content-editing.md for how to get a real place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJR0zjFTzbmUcRAbC_uztld74

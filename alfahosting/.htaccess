# Fahrschulring – redirects from the old PHP site to the new static site.
#
# Use this ONLY if www.fahrschulring.de is served from the Alfahosting
# webspace (the static `out/` folder uploaded next to kontakt.php). If the
# domain points at GitHub Pages instead, GitHub cannot send 301s — see
# knowledge/deployment.md and knowledge/url-migration-map.csv for the
# alternatives. Every old URL below was found indexed on 2026-10-09
# (knowledge/current-site-crawl.md); all on the www host.

RewriteEngine On

# One canonical host: https://www.fahrschulring.de (apex + http → www/https)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.fahrschulring\.de$ [NC]
RewriteRule ^ https://www.fahrschulring.de%{REQUEST_URI} [R=301,L]

# Old PHP pages → new pages (301 = permanent, passes link equity)
RedirectMatch 301 ^/pages/klassen\.php$      /klassen/
RedirectMatch 301 ^/pages/team\.php$         /team/
RedirectMatch 301 ^/pages/fahrzeuge\.php$    /#fuhrpark
RedirectMatch 301 ^/pages/kontakt\.php$      /kontakt/
RedirectMatch 301 ^/pages/anfahrt\.php$      /anfahrt/
RedirectMatch 301 ^/pages/impressum\.php$    /impressum/
RedirectMatch 301 ^/pages/datenschutz\.php$  /datenschutz/
RedirectMatch 301 ^/pages/index\.php$        /
RedirectMatch 301 ^/index\.php$              /
# kontakt.php at the root is the live form endpoint (alfahosting/kontakt.php)
# and must NOT be redirected.

# Any other leftover /pages/*.php → homepage (catch-all, keep last)
RedirectMatch 301 ^/pages/.*\.php$ /

# Static-site niceties: serve /klassen/ from klassen/index.html (default on
# Apache), add a proper 404 page from the Next.js export.
ErrorDocument 404 /404.html

# Cache immutable Next.js assets for a year, HTML briefly.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|jpg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
